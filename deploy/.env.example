# Deployment control file only. Copy to deploy/.env and keep permissions restricted.
# Runtime secrets belong in deploy/env/test.env or deploy/env/prod.env.

# TEST SSH target
CREHN_TEST_SSH_HOST=192.168.2.229
CREHN_TEST_SSH_PORT=22
CREHN_TEST_SSH_USER=replace-with-test-ssh-user
CREHN_TEST_SSH_AUTH=key
CREHN_TEST_SSH_KEY_PATH=
CREHN_TEST_SSH_PASSWORD=
CREHN_TEST_HOST_FINGERPRINT=

# ECS 2 production target. PROD-001 promotion requires key authentication for
# both the TEST jump host and this target; no password or private key is copied.
CREHN_ECS2_SSH_HOST=118.190.150.161
CREHN_ECS2_SSH_PORT=22
CREHN_ECS2_SSH_USER=replace-with-prod-ssh-user
CREHN_ECS2_SSH_AUTH=key
CREHN_ECS2_SSH_KEY_PATH=
CREHN_ECS2_SSH_PASSWORD=
CREHN_ECS2_HOST_FINGERPRINT=

# PROD-001 domain verification contract only. The promotion script never calls
# DNS APIs, requests certificates, or changes security groups/firewalls.
CREHN_PROD_PUBLIC_DOMAIN=cre.blog56.top
CREHN_PROD_EXPECTED_IPV4=118.190.150.161
