# Deployment control file only. Copy to deploy/.env and keep permissions restricted.
# Runtime secrets belong in deploy/env/test.env or deploy/env/prod.env.

# TEST SSH target
CREHN_TEST_SSH_HOST=192.168.2.229
CREHN_TEST_SSH_PORT=22
CREHN_TEST_SSH_USER=replace-with-test-ssh-user
CREHN_TEST_SSH_AUTH=key
CREHN_TEST_SSH_KEY_PATH=
CREHN_TEST_SSH_PASSWORD=
CREHN_TEST_HOST_FINGERPRINT=

# ECS 2 SSH target. Fill these values after the new ECS 2 is provisioned.
# Set CREHN_ECS2_SSH_AUTH to key or password. Passwords are passed through
# SSH_ASKPASS and must never be printed, copied to the server, or committed.
CREHN_ECS2_SSH_HOST=
CREHN_ECS2_SSH_PORT=22
CREHN_ECS2_SSH_USER=
CREHN_ECS2_SSH_AUTH=password
CREHN_ECS2_SSH_KEY_PATH=
CREHN_ECS2_SSH_PASSWORD=
CREHN_ECS2_HOST_FINGERPRINT=
