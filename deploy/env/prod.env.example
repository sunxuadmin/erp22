# Copy to prod.env only in the restricted production deployment area.
# Keep root:root:600 on Linux. Never commit the real file.

CREHN_VERSION=0.1.0
CREHN_SOURCE_REVISION=UNVERSIONED
CREHN_RUNTIME_ENV=prod
CREHN_COMPOSE_PROJECT_NAME=crehn-prod
CREHN_DEPLOY_ROOT=/srv/crehn-prod
CREHN_SOURCE_ROOT=/srv/crehn-prod/source
CREHN_DATA_ROOT=/srv/crehn-prod/data
CREHN_RELEASE_ROOT=/srv/crehn-prod/releases
CREHN_BACKUP_ROOT=/srv/crehn-prod/backups
CREHN_EVIDENCE_ROOT=/srv/crehn-prod/evidence
CREHN_STATE_ROOT=/srv/crehn-prod/state

# Web listens on loopback until a separately approved reverse proxy is configured.
CREHN_HTTP_BIND=127.0.0.1
CREHN_HTTP_PORT=28181

# Independent production data services
CREHN_DB_NAME=crehn_prod
CREHN_DB_USERNAME=crehn_prod
CREHN_DB_PASSWORD=
CREHN_DB_ROOT_PASSWORD=
CREHN_BOOTSTRAP_ADMIN_USERNAME=crehn-admin
CREHN_BOOTSTRAP_ADMIN_PASSWORD_HASH=
CREHN_REDIS_IMAGE=redis:7.4.2-alpine
CREHN_REDIS_PASSWORD=

# Application secrets and adjustable limits
CREHN_JWT_SECRET=
CREHN_MONITOR_USERNAME=crehn-health
CREHN_MONITOR_PASSWORD=
CREHN_MAX_FILE_SIZE=1GB
CREHN_MAX_REQUEST_SIZE=10GB
CREHN_NGINX_CLIENT_MAX_BODY_SIZE=10g
CREHN_BACKEND_MEMORY_LIMIT=4g
CREHN_DB_MEMORY_LIMIT=2g
CREHN_REDIS_MEMORY_LIMIT=512m
CREHN_WEB_MEMORY_LIMIT=256m
CREHN_UNDERTOW_IO_THREADS=8
CREHN_UNDERTOW_WORKER_THREADS=128
CREHN_HIKARI_MAX_POOL_SIZE=40
CREHN_HIKARI_MIN_IDLE=10
CREHN_REDISSON_THREADS=8
CREHN_REDISSON_NETTY_THREADS=16
CREHN_REDISSON_MIN_IDLE=8
CREHN_REDISSON_POOL_SIZE=32
CREHN_REDISSON_SUBSCRIPTION_POOL_SIZE=16
CREHN_OFFICE_WORKER_COUNT=2
CREHN_OFFICE_QUEUE_CAPACITY=100

# Production object storage: Aliyun OSS only.
ALIYUN_OSS_ENABLED=true
ALIYUN_OSS_DEFAULT=true
ALIYUN_OSS_CONFIG_KEY=crehn-prod-aliyun
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=crehn-prod
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_DOMAIN=
ALIYUN_OSS_REGION=
ALIYUN_OSS_HTTPS=Y
ALIYUN_OSS_ACCESS_POLICY=0
CREHN_PROD_OSS_BACKUP_REFERENCE=
