# Copy to test.env only on the TEST deployment controller/host.
# Keep root:root:600 on Linux. Never commit the real file.

CREHN_VERSION=0.1.0-test
CREHN_SOURCE_REVISION=UNVERSIONED
CREHN_RUNTIME_ENV=test
CREHN_COMPOSE_PROJECT_NAME=crehn-test
CREHN_DEPLOY_ROOT=/srv/crehn-test
CREHN_SOURCE_ROOT=/srv/crehn-test/source
CREHN_DATA_ROOT=/srv/crehn-test/data
CREHN_RELEASE_ROOT=/srv/crehn-test/releases
CREHN_BACKUP_ROOT=/srv/crehn-test/backups
CREHN_EVIDENCE_ROOT=/srv/crehn-test/evidence
CREHN_STATE_ROOT=/srv/crehn-test/state

# TEST network endpoints
CREHN_HTTP_BIND=192.168.2.229
CREHN_HTTP_PORT=28181
CREHN_MINIO_API_BIND=192.168.2.229
CREHN_MINIO_API_PORT=29000
CREHN_MINIO_CONSOLE_BIND=127.0.0.1
CREHN_MINIO_CONSOLE_PORT=29001

# Independent TEST data services
CREHN_DB_NAME=crehn_test
CREHN_DB_USERNAME=crehn_test
CREHN_DB_PASSWORD=replace-with-random-value
CREHN_DB_ROOT_PASSWORD=replace-with-different-random-value
CREHN_BOOTSTRAP_ADMIN_USERNAME=crehn-admin
CREHN_BOOTSTRAP_ADMIN_PASSWORD_HASH='$2b$12$replace-with-a-valid-bcrypt-hash-before-start'
CREHN_REDIS_IMAGE=redis:7.4.2-alpine
CREHN_REDIS_PASSWORD=replace-with-random-value
CREHN_MINIO_IMAGE=pgsty/minio@sha256:00c404465c4e7c4fd716d98caec2928e9e0f82c3548615662fdd3866ea9a28c0
CREHN_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
CREHN_MINIO_ROOT_USER=replace-with-minio-user
CREHN_MINIO_ROOT_PASSWORD=replace-with-minio-password
CREHN_MINIO_BUCKET=crehn-test
CREHN_MINIO_PUBLIC_DOMAIN=http://192.168.2.229:29000

# Application secrets and adjustable limits
CREHN_JWT_SECRET=replace-with-at-least-32-random-characters
CREHN_MONITOR_USERNAME=crehn-health
CREHN_MONITOR_PASSWORD=replace-with-random-value
CREHN_MAX_FILE_SIZE=1GB
CREHN_MAX_REQUEST_SIZE=10GB
CREHN_NGINX_CLIENT_MAX_BODY_SIZE=10g
CREHN_BACKEND_MEMORY_LIMIT=2g
CREHN_DB_MEMORY_LIMIT=768m
CREHN_REDIS_MEMORY_LIMIT=256m
CREHN_MINIO_MEMORY_LIMIT=512m
CREHN_WEB_MEMORY_LIMIT=128m
CREHN_UNDERTOW_IO_THREADS=4
CREHN_UNDERTOW_WORKER_THREADS=64
CREHN_HIKARI_MAX_POOL_SIZE=20
CREHN_HIKARI_MIN_IDLE=5
CREHN_REDISSON_THREADS=4
CREHN_REDISSON_NETTY_THREADS=8
CREHN_REDISSON_MIN_IDLE=4
CREHN_REDISSON_POOL_SIZE=16
CREHN_REDISSON_SUBSCRIPTION_POOL_SIZE=8
CREHN_OFFICE_WORKER_COUNT=1
CREHN_OFFICE_QUEUE_CAPACITY=50
CREHN_MAVEN_OPTS=-Xmx1536m -XX:MaxMetaspaceSize=512m
CREHN_ADMIN_NODE_OPTIONS=--max-old-space-size=3072
CREHN_PORTAL_NODE_OPTIONS=--max-old-space-size=1024

# Project A protection baseline
CREHN_PROTECTED_COMPOSE_PROJECT=dyz-current-shadow
CREHN_PROTECTED_WEB_URL=http://192.168.2.229:18181/
CREHN_PROTECTED_STORAGE_HEALTH_URL=http://192.168.2.229:19000/minio/health/live
