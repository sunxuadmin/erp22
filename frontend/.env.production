# 页面标题
VITE_APP_TITLE = 创意河南艺术设计大赛管理平台
VITE_APP_LOGO_TITLE = 创意河南

# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径，例如使用 /admin/
VITE_APP_CONTEXT_PATH = '/admin/'

# 监控地址
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# 生产环境接口
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS =

VITE_APP_PORT = 80

# 接口加密功能开关，需要与后端保持一致
VITE_APP_ENCRYPT = false
VITE_APP_RSA_PUBLIC_KEY = ''
VITE_APP_RSA_PRIVATE_KEY = ''

# 客户端 id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# websocket 开关，默认使用 sse 推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = true
